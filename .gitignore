# APEX-OS .gitignore

# User-specific runtime directories (created during installation)
opportunities/
analysis/
positions/
reports/

# Portfolio data (contains personal financial information)
portfolio/portfolio-config.yaml
portfolio/open-positions.yaml
portfolio/trade-history.yaml

# Keep portfolio templates
!profiles/*/portfolio/

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# Virtual environments
venv/
ENV/
env/
.venv

# Environment and secrets
.env
.env.local
.env.*.local

# IDEs
.vscode/
.idea/
*.swp
*.swo
*~

# OS-specific
.DS_Store
.AppleDouble
.LSOverride
._*
Thumbs.db
Desktop.ini
$RECYCLE.BIN/

# Logs
*.log
logs/

# Temporary files
*.tmp
*.temp
.cache/

# Market data cache
.market_data_cache/
.financial_data/
data/
scripts/fmp-api/fmp-data/
scripts/fmp-api/fmp-logs/

# YouTube data cache (from testing)
youtube-data/
youtube-logs/
scripts/youtube-api/youtube-data/
scripts/youtube-api/youtube-logs/

# Installed instances (not source)
.claude/

# Personal notes
PERSONAL_NOTES.md
TODO_PRIVATE.md
scratch/

# Backup files
*.bak
*.backup
backup/
