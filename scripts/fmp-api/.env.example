# FMP API Configuration
# Copy this file to .env and add your API key

# Required: Your Financial Modeling Prep API key
# Get your key from: https://financialmodelingprep.com/developer
FMP_API_KEY=your_api_key_here

# Optional: Customize data and log directories
# FMP_DATA_DIR=./fmp-data
# FMP_LOG_DIR=./fmp-logs

# Optional: API rate limiting (requests per minute)
# FMP_RATE_LIMIT=250

# Optional: Request timeout (seconds)
# FMP_TIMEOUT=30

# Optional: Maximum retry attempts for failed requests
# FMP_MAX_RETRIES=3

# Optional: Default limit for paginated results
# FMP_DEFAULT_LIMIT=10

# Optional: Default period for financial statements
# FMP_DEFAULT_PERIOD=annual
